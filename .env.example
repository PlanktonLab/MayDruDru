# --- 複製成 .env 放在 repo 根目錄；docker compose 會讀它 ---
# .env 永不進 git，VM 上 chmod 600（SPEC §13.5）。
# 本檔列出所有變數名稱；沒有任何一個帶真實值。

# development（本機）| production（部署）
# ENV=production 會在啟動時拒絕不安全的預設值：空的或過短的 SECRET_KEY、
# 未設定的 ORIGINAL_ENCRYPTION_KEY / PII_ENCRYPTION_KEY / RENDERER_TOKEN、預設的 MinIO 帳密。
ENV=development

# ---------------------------------------------------------------- LINE channel
# LINE_SENDER=noop 完全不連網（測試與本機預設）；line 才會呼叫 Messaging API。
LINE_SENDER=noop
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# apply-web build-time 設定；正式 GHCR 映像由 GitHub repository variable 同名值注入。
VITE_LINE_OA_ID=

# ------------------------------------------------------------------------- LLM
# openai（需要 OPENAI_API_KEY）或 fake（不連網、決定性替身）
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_MODEL=gpt-5.6-luna
# 復刻用較高階模型（實測 sol > luna > terra）；其餘任務沿用 DEFAULT_MODEL
MODEL_REPLICA=gpt-5.6-sol
MODEL_STRUCTURE=
MODEL_STYLEDOC=
MODEL_DESCRIBE=
MODEL_RERANK=
MODEL_INTENT=
MODEL_ASSISTANT=
REPLICA_VISUAL_REVIEW=true
VISUAL_REVIEW_MIN_SCORE=0.85
EMBEDDING_MODEL=text-embedding-3-small

# -------------------------------------------------------------------- security
# 至少 32 字元：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 承辦人原圖加密：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ORIGINAL_ENCRYPTION_KEY=
# 市民個資加密（與上面分開輪替）：同樣用 Fernet.generate_key()
PII_ENCRYPTION_KEY=
# api/worker 與 renderer 之間的共用密鑰：python -c "import secrets;print(secrets.token_hex(32))"
RENDERER_TOKEN=
# 本機可留空，部署必填；用 URL-safe 字元（例如 token_hex），因為會嵌進 REDIS_URL
REDIS_PASSWORD=
# 只在 Postgres volume 第一次建立時生效
POSTGRES_PASSWORD=

# -------------------------------------------------------- 物件儲存（MinIO / S3）
# 第一次啟動前務必換掉這兩個佔位值
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
# 新裝的 MayDru 使用預設 bucket。從 SOP_Tutor 搬遷時改成 sop-private / sop-public，
# 讓既有資料列仍能找到原本的物件 key。
S3_BUCKET_PRIVATE=maydru-private
S3_BUCKET_PUBLIC=maydru-public
# Browsers use this host for short-lived private-document URLs. In local Docker,
# MinIO is exposed on 9002; deployments should set their externally reachable S3 host.
S3_PUBLIC_ENDPOINT=localhost:9002
S3_PUBLIC_SECURE=false
S3_REGION=us-east-1

# ------------------------------------------------------------------ 對外網址
# 市民與 LINE 都要能連到的公開圖片網域
PUBLIC_MEDIA_BASE_URL=http://localhost:8202/media
APPLY_WEB_BASE_URL=http://localhost:8202
ADMIN_WEB_BASE_URL=http://localhost:8201
CORS_ORIGINS=["http://localhost:8201","http://localhost:8202","http://localhost:5173","http://localhost:5174"]

# ------------------------------------------------------------- 保存期限與門檻
SESSION_TTL_SECONDS=86400
ORIGINAL_TTL_DAYS=7
LOCATE_CONFIDENCE_THRESHOLD=0.6

# -------------------------------------------------------- 第一個 tenant 與 owner
# 第一次啟動時建立；留空則改用 /bootstrap 畫面。密碼至少 12 字元。
BOOTSTRAP_TENANT_NAME=新竹市政府
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=

# ------------------------------------------------------- 部署（prod compose 用）
# ghcr.io/<owner>/maydru-* 映像的擁有者與標籤
GHCR_OWNER=
IMAGE_TAG=latest
